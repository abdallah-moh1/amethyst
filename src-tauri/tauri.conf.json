{
    "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName": "amethyst",
    "version": "0.5.7",
    "identifier": "io.github.abdallah-moh1.amethyst",
    "build": {
        "frontendDist": "../dist",
        "devUrl": "http://localhost:5173",
        "beforeDevCommand": "npm run dev:renderer",
        "beforeBuildCommand": "npm run build"
    },
    "app": {
        "windows": [],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}
